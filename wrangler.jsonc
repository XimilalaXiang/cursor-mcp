{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cursor-cloud-agents-mcp-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
